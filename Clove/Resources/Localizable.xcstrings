    "RAW shows the file's own colours; the camera's preview fills the wait. Camera preview is quicker and lighter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RAW shows the file's own colours; the camera's preview fills the wait. Camera preview is quicker and lighter."
          }
