          }
        }
      }
    },
    "Rejected photos are moved, never deleted. Marking and filtering Rejects still work when Move Rejects is off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected photos are moved, never deleted. Marking and filtering Rejects still work when Move Rejects is off."
          }
