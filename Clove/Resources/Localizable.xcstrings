    },
    "Quick swipe input follows the enabled levels. Keep at least one level enabled. Ratings read from other apps still show when their level is off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick swipe input follows the enabled levels. Keep at least one level enabled. Ratings read from other apps still show when their level is off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻扫快速评分仅作用于已启用的星级。请至少保留一个星级；即使关闭某星级，来自其他应用的已有评分仍会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
