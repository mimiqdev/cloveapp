        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "淘汰的照片只会被移动，绝不会被删除。关闭此开关时仍可标记和筛选淘汰照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
