  "tokenDocs": {
    "bg/canvas": {
      "type": "color",
      "swiftName": "Color.clove.bg.canvas",
      "use": "App background behind lists, grids and chrome."
    },
    "bg/stage": {
      "type": "color",
      "swiftName": "Color.clove.bg.stage",
      "use": "Area around a photo in detail / zoom. Never tints the photo."
    },
    "surface/glass": {
      "type": "color",
      "swiftName": "Color.clove.surface.glass",
      "use": "Floating glass controls (capsule, dock, toasts, banners). Pair with a background blur of about 36 pt."
    },
    "surface/sheet": {
      "type": "color",
      "swiftName": "Color.clove.surface.sheet",
      "use": "Sheets, menus, grouped-list background."
    },
    "surface/card": {
      "type": "color",
      "swiftName": "Color.clove.surface.card",
      "use": "Cells / cards on a sheet."
    },
    "text/primary": {
      "type": "color",
      "swiftName": "Color.clove.text.primary",
      "use": "Primary text and icons."
    },
    "text/secondary": {
      "type": "color",
      "swiftName": "Color.clove.text.secondary",
      "use": "Secondary text, counts, metadata."
    },
    "separator": {
      "type": "color",
      "swiftName": "Color.clove.separator",
      "use": "Hairlines and tracks."
    },
    "accent": {
      "type": "color",
      "swiftName": "Color.clove.accent",
      "use": "Buttons, links, selection, progress while reading."
    },
    "rating/on": {
      "type": "color",
      "swiftName": "Color.clove.rating.on",
      "use": "Filled stars."
    },
    "rating/off": {
      "type": "color",
      "swiftName": "Color.clove.rating.off",
      "use": "Empty stars."
    },
    "reject": {
      "type": "color",
      "swiftName": "Color.clove.reject",
      "use": "Reject circle, destructive text. Softer than the system red on purpose."
    },
    "status/saved": {
      "type": "color",
      "swiftName": "Color.clove.status.saved",
      "use": "Saved dot, toggles on."
    },
    "status/failed": {
      "type": "color",
      "swiftName": "Color.clove.status.failed",
      "use": "Save or move failures."
    },
    "label/red": {
      "type": "color",
      "swiftName": "Color.clove.label.red",
      "use": "Color label red (XMP 'Red')."
    },
    "label/yellow": {
      "type": "color",
      "swiftName": "Color.clove.label.yellow",
      "use": "Color label yellow."
    },
    "label/green": {
      "type": "color",
      "swiftName": "Color.clove.label.green",
      "use": "Color label green."
    },
    "label/blue": {
      "type": "color",
      "swiftName": "Color.clove.label.blue",
      "use": "Color label blue."
    },
    "label/purple": {
      "type": "color",
      "swiftName": "Color.clove.label.purple",
      "use": "Color label purple."
    },
    "group": {
      "type": "color",
      "swiftName": "Color.clove.group",
      "use": "Similar groups: count badge on stacks, and a tint at 25% behind an expanded group in filmstrips."
    },
    "opacity/rejected": {
      "type": "float",
      "swiftName": null,
      "use": "Opacity of a rejected photo in the grid and strips."
    }
  }
